# Copy to .env and fill in. Never commit .env.

# --- GoHighLevel (required) ---------------------------------------------
# Sub-account > Settings > Private Integrations > Create new integration
# Scopes needed: contacts.readonly, contacts.write  (nothing else)
GHL_API_TOKEN=
# Sub-account > Settings > Business Profile > "Location ID" (also in the URL: /location/<id>/)
GHL_LOCATION_ID=

# --- Webhook security (required) -----------------------------------------
# Shared secret DisputeFox must send. At least 24 chars. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Safety switches -----------------------------------------------------
# true = look up matches in GHL but never create/update/tag anything
DRY_RUN=true
# Single-client test mode: when either is set, every other client is skipped
TEST_CLIENT_ID=
TEST_EMAIL=

# --- Optional ------------------------------------------------------------
# GHL contact custom field that should store the DisputeFox client ID.
# Use the field's ID (Settings > Custom Fields, or ask Claude to look it up).
# For Elevated Identities, "Dispute Fox Client ID" is: eaVyivFI5s1iZa9fLPkt
GHL_CLIENT_ID_FIELD_ID=
SYNC_TAG=disputefox-synced
DB_PATH=data/dfghl.sqlite3
PORT=8080
DEFAULT_COUNTRY_CODE=1
# If AutoFox cannot send the DisputeFox client ID, key clients by email instead
ALLOW_EMAIL_AS_CLIENT_ID=false
# Retries for GHL outages before an event is marked failed
MAX_ATTEMPTS=6
# GHL allows 100 requests / 10s per location; stay under it
RATE_LIMIT_PER_10S=80
# Override payload field names if DisputeFox uses names we don't recognise:
# FIELD_CLIENT_ID=
# FIELD_FIRST_NAME=
# FIELD_LAST_NAME=
# FIELD_EMAIL=
# FIELD_PHONE=
